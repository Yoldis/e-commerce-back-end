// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// DB

enum Roles {
  Admin
  User
  Company
}

enum Sizes {
  Small
  Medium
  Large
  X_Large
}

model Company {
  id           Int    @id @default(autoincrement())
  tradeName    String @unique
  businessName String @unique
  phone        String @unique
  email        String @unique
  address      String
  currency     String
  logo         String

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  products   Product[]
  categories Category[]
}

model Role {
  id    Int    @id @default(autoincrement())
  name  Roles  @unique
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  avatar    String?

  order         Order[]
  shoopingCarts ShoopingCart[]
  company       Company?
}

model ProductImages {
  id        Int     @id @default(autoincrement())
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id          Int    @id @default(autoincrement())
  name        String
  description String

  companyId         Int
  company           Company             @relation(fields: [companyId], references: [id])
  productCategories ProductCategories[]
}

model ProductCategories {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  inStock     Int
  sizes       Sizes[]
  createdAt   DateTime @default(now())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  productImages     ProductImages[]
  productCategories ProductCategories[]
  shoopingCarts     ShoopingCart[]
  orderDetails      OrderDetails[]
  offerts           Offer[]
}

model ShoopingCart {
  id          Int    @id @default(autoincrement())
  productName String
  image       String
  size        Sizes
  price       Float
  unit        Int
  subTotal    Float

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id           Int            @id @default(autoincrement())
  user         User           @relation(fields: [userId], references: [id])
  userId       Int
  total        Float
  unitTotal    Int
  createdAt    DateTime       @default(now())
  isPaid       Boolean
  orderDetails OrderDetails[]
}

model OrderDetails {
  id          Int    @id @default(autoincrement())
  productName String
  image       String
  price       Float
  unit        Int
  subTotal    Float
  size        String
  order       Order  @relation(fields: [orderId], references: [id])
  orderId     Int

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction)
}

model Offer {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            OffertType
  value           Decimal  @db.Decimal(10, 2)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  description     String?  @db.VarChar(255)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([startDate, endDate])
}

enum OffertType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
}



// PERCENTAGE: el valor es un porcentaje.
// Precio: 1000
// Valor: 20
// Resultado: 1000 - (20%) = 800
// FIXED_AMOUNT: el valor es una cantidad de dinero que se resta.
// Precio: 1000
// Valor: 100
// Resultado: 1000 - 100 = 900
// FIXED_PRICE: el valor es el nuevo precio, sin hacer cálculos.
// Precio: 1000
// Valor: 500
// Resultado: 500